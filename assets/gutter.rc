// Recursos de Windows para Gutter.exe: icono y propiedades del archivo.
// Se compila con windres/llvm-rc a rsrc_windows_amd64.syso.

1 ICON "gutter.ico"

1 VERSIONINFO
FILEVERSION 1,1,1,0
PRODUCTVERSION 1,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Skeiceee"
            VALUE "FileDescription", "Gutter - Lector de comics CBR/CBZ"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "InternalName", "Gutter"
            VALUE "LegalCopyright", "Copyright (c) 2026 Skeiceee - Licencia MIT"
            VALUE "OriginalFilename", "Gutter.exe"
            VALUE "ProductName", "Gutter"
            VALUE "ProductVersion", "1.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
